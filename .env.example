# انسخ الملف باسم .env محليًا، ثم استخدم بيانات قاعدة Turso المخصصة لبيئة التطوير.
# التطبيق وseed يتصلان بـTurso فقط؛ لا تضع قاعدة dev أو production نفسها في GitHub.
TURSO_DATABASE_URL="libsql://your-development-database.turso.io"
TURSO_AUTH_TOKEN="replace-with-your-development-database-token"

# سر توقيع الجلسات — ولّد قيمة عشوائية مستقلة لكل بيئة:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET="replace-with-a-unique-random-secret"

# بيانات الأدمن التي يستخدمها npm run db:seed
# ADMIN_EMAIL="you@yourstore.com"
# ADMIN_PASSWORD="strong-password-here"
