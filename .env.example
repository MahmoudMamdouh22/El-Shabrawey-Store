# ═══ انسخ الملف ده باسم .env وعدّل القيم ═══
#   cp .env.example .env

# قاعدة البيانات (SQLite — ملف محلي، مفيش سيرفر خارجي مطلوب)
DATABASE_URL="file:./dev.db"

# اتصال Turso اختياري للتجربة السحابية (لا تضع القيم الحقيقية في هذا الملف)
# اترك DATABASE_URL محليًا حتى تظل أوامر Prisma ومشروع التطوير على dev.db.
# TURSO_DATABASE_URL="libsql://your-database.turso.io"
# TURSO_AUTH_TOKEN="your-database-auth-token"

# سر توقيع جلسات الدخول — لازم تولّد واحد جديد خاص بيك (32 حرف على الأقل):
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET="replace-with-a-random-secret"

# (اختياري) بيانات الأدمن اللي بيتعمل بأمر npm run db:seed
# لو سيبتهم فاضيين هيتعمل: admin@syntax.eg / Admin@12345 — غيّرهم في الإنتاج!
# ADMIN_EMAIL="you@yourstore.com"
# ADMIN_PASSWORD="strong-password-here"
