// Prisma schema — متجر الشبراوي ستور
// بيانات المنتجات والعملاء والطلبات الخاصة بمتجر الشبراوي ستور.
// docs: https://pris.ly/d/prisma-schema

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
  output          = "../app/generated/prisma"
}

datasource db {
  provider = "sqlite"
}